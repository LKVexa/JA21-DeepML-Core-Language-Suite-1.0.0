deepml core 0.3
module corpus.deepml_core.example_05059
policy deterministic
policy no_network
module Encoder { fn run(x: f32[batch,7]) -> f32[batch,4] = relu(matmul(x, variable("enc"))) }
module Decoder { fn run(x: f32[batch,4]) -> f32[batch,7] = matmul(x, variable("dec")) }
graph Graph05059 train_infer {
  encoded = Encoder.run(input("sensor"))
  logic = embed deepml.logic version 0.3 { fn gate(x: Flag) -> Flag = x }
  scene_state = bind ja.portal.scene::SceneState(encoded)
  timeline_state = bind mcrt.portal.timeline::TimelineState(encoded)
  output = Decoder.run(encoded)
  loss = mse(output, target("sensor"))
}
checkpoint "pipeline_05059" every 29 steps
package model Graph05059 as "model_05059.msslb"
