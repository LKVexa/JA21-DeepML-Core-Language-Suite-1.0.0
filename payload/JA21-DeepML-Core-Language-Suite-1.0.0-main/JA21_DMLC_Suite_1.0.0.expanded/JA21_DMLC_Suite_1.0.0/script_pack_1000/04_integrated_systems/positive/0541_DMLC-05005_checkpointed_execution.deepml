deepml core 0.3
module corpus.deepml_core.example_05005
policy deterministic
policy no_network
module Encoder { fn run(x: f32[batch,4]) -> f32[batch,3] = relu(matmul(x, variable("enc"))) }
module Decoder { fn run(x: f32[batch,3]) -> f32[batch,4] = matmul(x, variable("dec")) }
graph Graph05005 train_infer {
  encoded = Encoder.run(input("sensor"))
  logic = embed deepml.logic version 0.3 { fn gate(x: Flag) -> Flag = x }
  scene_state = bind ja.portal.scene::SceneState(encoded)
  timeline_state = bind mcrt.portal.timeline::TimelineState(encoded)
  output = Decoder.run(encoded)
  loss = mse(output, target("sensor"))
}
checkpoint "pipeline_05005" every 65 steps
package model Graph05005 as "model_05005.msslb"
