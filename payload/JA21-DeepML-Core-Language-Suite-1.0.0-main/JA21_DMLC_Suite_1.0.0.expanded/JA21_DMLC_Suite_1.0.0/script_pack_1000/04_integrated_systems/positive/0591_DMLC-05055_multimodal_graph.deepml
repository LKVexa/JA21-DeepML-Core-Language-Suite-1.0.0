deepml core 0.3
module corpus.deepml_core.example_05055
policy deterministic
policy no_network
module Encoder { fn run(x: f32[batch,3]) -> f32[batch,4] = relu(matmul(x, variable("enc"))) }
module Decoder { fn run(x: f32[batch,4]) -> f32[batch,3] = matmul(x, variable("dec")) }
graph Graph05055 train_infer {
  encoded = Encoder.run(input("sensor"))
  logic = embed deepml.logic version 0.3 { fn gate(x: Flag) -> Flag = x }
  scene_state = bind ja.portal.scene::SceneState(encoded)
  timeline_state = bind mcrt.portal.timeline::TimelineState(encoded)
  output = Decoder.run(encoded)
  loss = mse(output, target("sensor"))
}
checkpoint "pipeline_05055" every 25 steps
package model Graph05055 as "model_05055.msslb"
