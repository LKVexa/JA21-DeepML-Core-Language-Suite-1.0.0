deepml core 0.3
module corpus.deepml_core.example_05180
policy deterministic
policy no_network
module Encoder { fn run(x: f32[batch,7]) -> f32[batch,3] = relu(matmul(x, variable("enc"))) }
module Decoder { fn run(x: f32[batch,3]) -> f32[batch,7] = matmul(x, variable("dec")) }
graph Graph05180 train_infer {
  encoded = Encoder.run(input("sensor"))
  logic = embed deepml.logic version 0.3 { fn gate(x: Flag) -> Flag = x }
  scene_state = bind ja.portal.scene::SceneState(encoded)
  timeline_state = bind mcrt.portal.timeline::TimelineState(encoded)
  output = Decoder.run(encoded)
  loss = mse(output, target("sensor"))
}
checkpoint "pipeline_05180" every 60 steps
package model Graph05180 as "model_05180.msslb"
verify semantic_hash == "invalid-05180"
