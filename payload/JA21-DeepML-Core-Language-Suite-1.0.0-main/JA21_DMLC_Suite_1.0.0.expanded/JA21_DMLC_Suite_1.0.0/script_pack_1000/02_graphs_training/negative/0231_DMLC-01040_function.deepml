deepml core 0.3
module corpus.deepml_core.example_01040
policy deterministic
policy no_network
fn dense(input: f32[batch,3], weight: f32[3,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[6,3] = random.normal(seed=1040)
tensor target: f32[6,3] = constant(1.0)
graph Graph01040 {
  prediction = dense(input, variable("w", seed=1040))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01040 on cpu
verify semantic_hash == "invalid-01040"
