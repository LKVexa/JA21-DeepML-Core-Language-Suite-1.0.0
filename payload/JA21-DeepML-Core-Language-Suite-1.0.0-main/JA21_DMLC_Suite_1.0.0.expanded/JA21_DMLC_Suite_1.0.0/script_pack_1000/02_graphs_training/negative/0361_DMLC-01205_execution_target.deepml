deepml core 0.3
module corpus.deepml_core.example_01205
policy deterministic
policy no_network
fn dense(input: f32[batch,3], weight: f32[3,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[3,3] = random.normal(seed=1205)
tensor target: f32[3,4] = constant(1.0)
graph Graph01205 {
  prediction = dense(input, variable("w", seed=1205))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
