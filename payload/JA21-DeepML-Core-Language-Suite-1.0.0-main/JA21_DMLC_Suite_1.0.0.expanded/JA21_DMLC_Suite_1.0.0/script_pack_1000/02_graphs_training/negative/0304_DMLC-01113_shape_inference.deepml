policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[6,6] = random.normal(seed=1113)
tensor target: f32[6,3] = constant(1.0)
graph Graph01113 {
  prediction = dense(input, variable("w", seed=1113))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
