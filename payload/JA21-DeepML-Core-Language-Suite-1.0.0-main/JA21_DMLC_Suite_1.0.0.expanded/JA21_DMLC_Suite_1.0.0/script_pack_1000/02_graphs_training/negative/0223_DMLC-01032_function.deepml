deepml core 0.3
module corpus.deepml_core.example_01032
policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[5,6] = random.normal(seed=1032)
tensor target: f32[5,2] = constant(1.0)
graph Graph01032 {
  prediction = dense(input, variable("w", seed=1032))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01032 on cpu
verify semantic_hash == "invalid-01032"
