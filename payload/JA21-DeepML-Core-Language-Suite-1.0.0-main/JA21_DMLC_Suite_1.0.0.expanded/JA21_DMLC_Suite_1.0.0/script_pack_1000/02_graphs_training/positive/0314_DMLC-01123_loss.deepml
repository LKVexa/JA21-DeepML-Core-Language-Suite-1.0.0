module corpus.deepml_core.example_01123
policy deterministic
policy no_network
fn dense(input: f32[batch,5], weight: f32[5,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[4,5] = random.normal(seed=1123)
tensor target: f32[4,2] = constant(1.0)
graph Graph01123 {
  prediction = dense(input, variable("w", seed=1123))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
