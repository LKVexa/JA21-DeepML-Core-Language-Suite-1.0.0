deepml core 0.3
module corpus.deepml_core.example_01152
policy deterministic
policy no_network
fn dense(input: f32[batch,5], weight: f32[5,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[6,5] = random.normal(seed=1152)
tensor target: f32[6,3] = constant(1.0)
graph Graph01152 {
  prediction = dense(input, variable("w", seed=1152))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01152 on cpu
