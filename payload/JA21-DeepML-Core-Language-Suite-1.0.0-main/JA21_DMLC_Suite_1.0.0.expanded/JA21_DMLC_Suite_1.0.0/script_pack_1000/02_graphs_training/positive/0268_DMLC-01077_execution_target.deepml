module corpus.deepml_core.example_01077
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[4,7] = random.normal(seed=1077)
tensor target: f32[4,5] = constant(1.0)
graph Graph01077 {
  prediction = dense(input, variable("w", seed=1077))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
