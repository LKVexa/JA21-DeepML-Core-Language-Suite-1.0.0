deepml core 0.3
module corpus.deepml_core.example_01010
policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[5,6] = random.normal(seed=1010)
tensor target: f32[5,5] = constant(1.0)
graph Graph01010 {
  prediction = dense(input, variable("w", seed=1010))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01010 on gpu:1
