module corpus.deepml_core.example_01025
policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[3,6] = random.normal(seed=1025)
tensor target: f32[3,2] = constant(1.0)
graph Graph01025 {
  prediction = dense(input, variable("w", seed=1025))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
