deepml core 0.3
module corpus.deepml_core.example_01144
policy deterministic
policy no_network
fn dense(input: f32[batch,4], weight: f32[4,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[3,4] = random.normal(seed=1144)
tensor target: f32[3,2] = constant(1.0)
graph Graph01144 {
  prediction = dense(input, variable("w", seed=1144))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
