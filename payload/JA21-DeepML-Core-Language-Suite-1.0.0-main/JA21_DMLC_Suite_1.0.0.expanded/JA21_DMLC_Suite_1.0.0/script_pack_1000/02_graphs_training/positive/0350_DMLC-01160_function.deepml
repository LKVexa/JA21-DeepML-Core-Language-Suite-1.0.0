deepml core 0.3
module corpus.deepml_core.example_01160
policy deterministic
policy no_network
fn dense(input: f32[batch,2], weight: f32[2,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[2,2] = random.normal(seed=1160)
tensor target: f32[2,4] = constant(1.0)
graph Graph01160 {
  prediction = dense(input, variable("w", seed=1160))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01160 on cpu
