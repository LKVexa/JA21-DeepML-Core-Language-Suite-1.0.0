module corpus.deepml_core.example_01074
policy deterministic
policy no_network
fn dense(input: f32[batch,4], weight: f32[4,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[6,4] = random.normal(seed=1074)
tensor target: f32[6,2] = constant(1.0)
graph Graph01074 {
  prediction = dense(input, variable("w", seed=1074))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
