deepml core 0.3
module corpus.deepml_core.example_01016
policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[6,8] = random.normal(seed=1016)
tensor target: f32[6,4] = constant(1.0)
graph Graph01016 {
  prediction = dense(input, variable("w", seed=1016))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01016 on cpu
