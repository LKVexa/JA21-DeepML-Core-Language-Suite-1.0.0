module corpus.deepml_core.example_01165
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[2,7] = random.normal(seed=1165)
tensor target: f32[2,2] = constant(1.0)
graph Graph01165 {
  prediction = dense(input, variable("w", seed=1165))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
