deepml core 0.3
module corpus.deepml_core.example_01142
policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[6,6] = random.normal(seed=1142)
tensor target: f32[6,4] = constant(1.0)
graph Graph01142 {
  prediction = dense(input, variable("w", seed=1142))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
