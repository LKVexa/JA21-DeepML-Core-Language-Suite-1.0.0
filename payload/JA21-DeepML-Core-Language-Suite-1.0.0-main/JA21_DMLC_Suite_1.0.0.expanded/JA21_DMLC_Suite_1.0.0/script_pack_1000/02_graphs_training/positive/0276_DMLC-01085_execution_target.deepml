deepml core 0.3
module corpus.deepml_core.example_01085
policy deterministic
policy no_network
fn dense(input: f32[batch,4], weight: f32[4,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[2,4] = random.normal(seed=1085)
tensor target: f32[2,3] = constant(1.0)
graph Graph01085 {
  prediction = dense(input, variable("w", seed=1085))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
