policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[3,8] = random.normal(seed=1137)
tensor target: f32[3,2] = constant(1.0)
graph Graph01137 {
  prediction = dense(input, variable("w", seed=1137))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
