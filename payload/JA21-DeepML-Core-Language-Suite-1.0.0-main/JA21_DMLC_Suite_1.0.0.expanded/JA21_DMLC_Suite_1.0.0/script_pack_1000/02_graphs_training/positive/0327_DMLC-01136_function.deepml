module corpus.deepml_core.example_01136
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[2,7] = random.normal(seed=1136)
tensor target: f32[2,5] = constant(1.0)
graph Graph01136 {
  prediction = dense(input, variable("w", seed=1136))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
