module corpus.deepml_core.example_01158
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[5,7] = random.normal(seed=1158)
tensor target: f32[5,2] = constant(1.0)
graph Graph01158 {
  prediction = dense(input, variable("w", seed=1158))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
