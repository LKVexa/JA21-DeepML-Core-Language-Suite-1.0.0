deepml core 0.3
module corpus.deepml_core.example_01111
policy deterministic
policy no_network
fn dense(input: f32[batch,4], weight: f32[4,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[4,4] = random.normal(seed=1111)
tensor target: f32[4,4] = constant(1.0)
graph Graph01111 {
  prediction = dense(input, variable("w", seed=1111))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
