module corpus.deepml_core.example_01037
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[3,7] = random.normal(seed=1037)
tensor target: f32[3,4] = constant(1.0)
graph Graph01037 {
  prediction = dense(input, variable("w", seed=1037))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
