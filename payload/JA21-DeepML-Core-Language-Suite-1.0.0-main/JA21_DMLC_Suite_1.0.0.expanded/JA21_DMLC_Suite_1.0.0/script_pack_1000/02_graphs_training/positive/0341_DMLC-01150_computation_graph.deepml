deepml core 0.3
module corpus.deepml_core.example_01150
policy deterministic
policy no_network
fn dense(input: f32[batch,3], weight: f32[3,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[4,3] = random.normal(seed=1150)
tensor target: f32[4,5] = constant(1.0)
graph Graph01150 {
  prediction = dense(input, variable("w", seed=1150))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01150 on gpu:1
