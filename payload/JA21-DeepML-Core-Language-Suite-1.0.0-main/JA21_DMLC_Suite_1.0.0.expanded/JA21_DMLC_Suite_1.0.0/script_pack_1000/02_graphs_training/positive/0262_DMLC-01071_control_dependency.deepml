module corpus.deepml_core.example_01071
policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[3,8] = random.normal(seed=1071)
tensor target: f32[3,3] = constant(1.0)
graph Graph01071 {
  prediction = dense(input, variable("w", seed=1071))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
