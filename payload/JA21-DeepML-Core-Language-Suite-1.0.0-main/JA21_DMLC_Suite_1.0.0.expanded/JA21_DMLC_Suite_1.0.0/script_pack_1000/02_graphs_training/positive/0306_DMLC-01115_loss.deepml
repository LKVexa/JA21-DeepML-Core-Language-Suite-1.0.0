module corpus.deepml_core.example_01115
policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[3,8] = random.normal(seed=1115)
tensor target: f32[3,5] = constant(1.0)
graph Graph01115 {
  prediction = dense(input, variable("w", seed=1115))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
