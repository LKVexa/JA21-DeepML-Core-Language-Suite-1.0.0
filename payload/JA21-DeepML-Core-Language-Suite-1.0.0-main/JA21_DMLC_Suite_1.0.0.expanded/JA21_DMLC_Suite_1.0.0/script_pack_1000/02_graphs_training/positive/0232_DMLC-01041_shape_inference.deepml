module corpus.deepml_core.example_01041
policy deterministic
policy no_network
fn dense(input: f32[batch,4], weight: f32[4,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[2,4] = random.normal(seed=1041)
tensor target: f32[2,4] = constant(1.0)
graph Graph01041 {
  prediction = dense(input, variable("w", seed=1041))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
