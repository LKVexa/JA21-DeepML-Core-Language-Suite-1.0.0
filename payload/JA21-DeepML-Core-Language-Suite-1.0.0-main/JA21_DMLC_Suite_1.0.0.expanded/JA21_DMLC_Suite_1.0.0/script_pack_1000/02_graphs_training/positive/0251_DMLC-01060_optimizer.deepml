deepml core 0.3
module corpus.deepml_core.example_01060
policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[4,8] = random.normal(seed=1060)
tensor target: f32[4,2] = constant(1.0)
graph Graph01060 {
  prediction = dense(input, variable("w", seed=1060))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01060 on cpu
