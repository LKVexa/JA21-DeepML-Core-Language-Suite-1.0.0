module corpus.deepml_core.example_01017
policy deterministic
policy no_network
fn dense(input: f32[batch,2], weight: f32[2,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[2,2] = random.normal(seed=1017)
tensor target: f32[2,5] = constant(1.0)
graph Graph01017 {
  prediction = dense(input, variable("w", seed=1017))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
