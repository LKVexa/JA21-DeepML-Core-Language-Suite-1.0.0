deepml core 0.3
module corpus.deepml_core.example_01098
policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[3,6] = random.normal(seed=1098)
tensor target: f32[3,5] = constant(1.0)
graph Graph01098 {
  prediction = dense(input, variable("w", seed=1098))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01098 on gpu:1
