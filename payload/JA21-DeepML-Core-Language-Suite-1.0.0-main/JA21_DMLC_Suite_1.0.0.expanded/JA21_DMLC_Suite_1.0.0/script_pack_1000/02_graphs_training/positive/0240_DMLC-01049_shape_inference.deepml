module corpus.deepml_core.example_01049
policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,5]) -> f32[batch,5] { return relu(matmul(input, weight)) }
tensor input: f32[5,8] = random.normal(seed=1049)
tensor target: f32[5,5] = constant(1.0)
graph Graph01049 {
  prediction = dense(input, variable("w", seed=1049))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
