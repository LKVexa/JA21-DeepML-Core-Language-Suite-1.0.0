deepml core 0.3
module corpus.deepml_core.example_01064
policy deterministic
policy no_network
fn dense(input: f32[batch,5], weight: f32[5,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[3,5] = random.normal(seed=1064)
tensor target: f32[3,3] = constant(1.0)
graph Graph01064 {
  prediction = dense(input, variable("w", seed=1064))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
