deepml core 0.3
module corpus.deepml_core.example_01020
policy deterministic
policy no_network
fn dense(input: f32[batch,5], weight: f32[5,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[3,5] = random.normal(seed=1020)
tensor target: f32[3,4] = constant(1.0)
graph Graph01020 {
  prediction = dense(input, variable("w", seed=1020))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01020 on cpu
