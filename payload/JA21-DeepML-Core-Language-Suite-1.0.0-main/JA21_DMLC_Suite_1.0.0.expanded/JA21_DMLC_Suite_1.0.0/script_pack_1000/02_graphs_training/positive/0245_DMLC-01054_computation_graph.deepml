deepml core 0.3
module corpus.deepml_core.example_01054
policy deterministic
policy no_network
fn dense(input: f32[batch,6], weight: f32[6,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[3,6] = random.normal(seed=1054)
tensor target: f32[3,3] = constant(1.0)
graph Graph01054 {
  prediction = dense(input, variable("w", seed=1054))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01054 on gpu:1
