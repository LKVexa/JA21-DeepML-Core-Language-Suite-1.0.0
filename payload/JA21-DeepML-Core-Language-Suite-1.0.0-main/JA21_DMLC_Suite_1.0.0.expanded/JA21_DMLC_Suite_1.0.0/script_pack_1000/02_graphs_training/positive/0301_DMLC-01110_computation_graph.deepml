deepml core 0.3
module corpus.deepml_core.example_01110
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[3,7] = random.normal(seed=1110)
tensor target: f32[3,3] = constant(1.0)
graph Graph01110 {
  prediction = dense(input, variable("w", seed=1110))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01110 on gpu:1
