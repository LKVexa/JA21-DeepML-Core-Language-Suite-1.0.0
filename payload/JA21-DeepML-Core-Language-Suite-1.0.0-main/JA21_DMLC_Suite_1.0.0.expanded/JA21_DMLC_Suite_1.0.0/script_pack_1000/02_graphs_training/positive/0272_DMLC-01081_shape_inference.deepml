deepml core 0.3
module corpus.deepml_core.example_01081
policy deterministic
policy no_network
fn dense(input: f32[batch,7], weight: f32[7,2]) -> f32[batch,2] { return relu(matmul(input, weight)) }
tensor input: f32[3,7] = random.normal(seed=1081)
tensor target: f32[3,2] = constant(1.0)
graph Graph01081 {
  prediction = dense(input, variable("w", seed=1081))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
