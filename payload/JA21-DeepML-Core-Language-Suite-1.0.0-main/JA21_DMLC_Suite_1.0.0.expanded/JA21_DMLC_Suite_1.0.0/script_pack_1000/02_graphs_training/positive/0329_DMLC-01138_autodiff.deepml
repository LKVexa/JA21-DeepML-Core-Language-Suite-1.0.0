module corpus.deepml_core.example_01138
policy deterministic
policy no_network
fn dense(input: f32[batch,2], weight: f32[2,3]) -> f32[batch,3] { return relu(matmul(input, weight)) }
tensor input: f32[4,2] = random.normal(seed=1138)
tensor target: f32[4,3] = constant(1.0)
graph Graph01138 {
  prediction = dense(input, variable("w", seed=1138))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
