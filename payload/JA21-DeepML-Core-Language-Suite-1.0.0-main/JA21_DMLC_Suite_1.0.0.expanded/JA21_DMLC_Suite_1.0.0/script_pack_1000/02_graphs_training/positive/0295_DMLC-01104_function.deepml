deepml core 0.3
module corpus.deepml_core.example_01104
policy deterministic
policy no_network
fn dense(input: f32[batch,8], weight: f32[8,4]) -> f32[batch,4] { return relu(matmul(input, weight)) }
tensor input: f32[4,8] = random.normal(seed=1104)
tensor target: f32[4,4] = constant(1.0)
graph Graph01104 {
  prediction = dense(input, variable("w", seed=1104))
  loss = mse(prediction, target)
  gradients = grad(loss, parameters())
  update = adam(gradients, learning_rate=0.001)
}
execute Graph01104 on cpu
